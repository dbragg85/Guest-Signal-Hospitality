# Canonical origin for SEO (metadataBase, sitemap, robots). Set in CI for GitHub Pages.
# Example: https://guestsignalhospitality.com
NEXT_PUBLIC_SITE_URL=https://guestsignalhospitality.com

# Create a project at https://supabase.com — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Monthly pipeline runtime (service role + Apify)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APIFY_TOKEN=your-apify-token
# Lead intake automation (scripts/process-lead-intake-snapshot.mjs + GitHub Actions lead-intake-snapshot.yml)
APIFY_GOOGLE_ACTOR_ID=your-google-maps-reviews-actor-id
# Optional: fixed Google Maps place or search URL; otherwise built from intake address + business name
# APIFY_GOOGLE_START_URL=https://www.google.com/maps/place/...
# Optional JSON template (see scripts/lib/apify-google-reviews.mjs); placeholders {{GOOGLE_URL}}, {{MAX_REVIEWS}}
# APIFY_GOOGLE_INPUT_TEMPLATE_JSON={"startUrls":[{"url":"{{GOOGLE_URL}}"}],"maxReviews":{{MAX_REVIEWS}}}
LEAD_INTAKE_MAX_REVIEWS=50
SCORING_TIMEZONE=America/New_York
# Yelp in intake pipeline is off unless LEAD_INTAKE_ENABLE_YELP=1
# LEAD_INTAKE_ENABLE_YELP=0
APIFY_YELP_ACTOR_ID=your-apify-actor-id
# LEAD_INTAKE_APIFY_YELP_URL=https://www.yelp.com/biz/...   # optional override; else set YELP_FUSION_API_KEY to auto-resolve from lead address
# YELP_FUSION_API_KEY=...   # Yelp Fusion v3 (https://www.yelp.com/developers) — lead intake resolves Yelp URL from business + city/state/zip
# Optional: Zapier/Make or Edge Function URL after a lead converts (JSON POST)
# LEAD_INTAKE_SUCCESS_WEBHOOK_URL=
#
# Portal invite redirect (Supabase Auth → must match Dashboard → Auth → Redirect URLs)
# Defaults: invite lands on NEXT_PUBLIC_SITE_URL/portal/welcome/ ; emails use .../portal for sign-in
# LEAD_INTAKE_INVITE_REDIRECT_URL=https://guestsignalhospitality.com/portal/welcome/
# LEAD_INTAKE_PORTAL_BASE_URL=https://guestsignalhospitality.com/portal
#
# Resend — email the submitter portal sign-in + dashboard link after conversion (with LEAD_INTAKE_INVITE_PORTAL_USERS)
# https://resend.com — verify your domain; for tests you can use onboarding@resend.dev with Resend’s allowed recipients.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Guest Signal <onboarding@resend.dev>

# Newsletter capture destination shown in UI and used by submit flow
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://formsubmit.co/ajax/audit@guestsignalhospitality.com
NEXT_PUBLIC_NEWSLETTER_PROVIDER=FormSubmit
NEXT_PUBLIC_NEWSLETTER_DESTINATION=audit@guestsignalhospitality.com inbox

# AI-powered prospect outreach (optional — falls back to templates without it)
# Get your API key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o  # Default: gpt-4o. Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
# SKIP_AI_ENHANCEMENT=0  # Set to 1 to skip AI enhancement even with API key configured
# AI_CONCURRENCY=3  # Max concurrent AI requests (1-10, default 3)

# -----------------------------------------------------------------------------
# Where real secrets live (never commit real values to git)
# Copy this file to .env.local, replace placeholders, keep .env.local private.
# -----------------------------------------------------------------------------
#
# Completion checklist for lead intake + Pages (tick when done in .env.local + GitHub):
# [ ] NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY — browser intake + portal build
# [ ] SUPABASE_URL (same host) + SUPABASE_SERVICE_ROLE_KEY — Actions job only (also gh secret)
# [ ] APIFY_TOKEN — Actions secret
# [ ] APIFY_GOOGLE_ACTOR_ID — Actions variable (actor id string, not secret)
# [ ] LEAD_INTAKE_MAX_REVIEWS=50, SCORING_TIMEZONE=America/New_York (optional overrides)
# [ ] Optional: APIFY_GOOGLE_START_URL or APIFY_GOOGLE_INPUT_TEMPLATE_JSON if your actor needs custom input
# [ ] Optional: LEAD_INTAKE_INVITE_PORTAL_USERS=1 for Supabase invite after snapshot
# [ ] Optional: LEAD_INTAKE_SUCCESS_WEBHOOK_URL for post-conversion automation (Actions secret)
# Then: npm run sync:github-vars (GITHUB_TOKEN) and npm run sync:github-secrets (gh auth login)
#
# Trigger the lead-intake GitHub Action from your machine (no Supabase webhook required):
#   GITHUB_DISPATCH_TOKEN=github_pat_... or ghp_...   — classic PAT with "repo", or fine-grained Contents: Read/Write
#   Optional: GITHUB_DISPATCH_REPOSITORY=owner/repo    — default dbragg85/Guest-Signal-Hospitality
# Then: npm run dispatch:lead-intake
#       npm run dispatch:lead-intake -- --latest     — passes newest pending row id (needs SUPABASE_* in this file)
# -----------------------------------------------------------------------------
